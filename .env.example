# ===========================================
# WorkerGigBD - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control!

# ===========================================
# SUPABASE DATABASE CONNECTION
# ===========================================
# 1. Go to: https://supabase.com/dashboard
# 2. Select your project (tsokfguhydwausvuaaiw)
# 3. Settings → Database
# 4. Find "Connection String" → "URI" tab
# 5. Copy the URI and paste below (replace [YOUR-PASSWORD])
# 
# IMPORTANT: Use port 6543 (Supabase Pooler) NOT 5432!
# 
DATABASE_URL=postgresql://postgres.tsokfguhydwausvuaaiw:YOUR_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct URL for migrations (use port 5432)
DIRECT_URL=postgresql://postgres.tsokfguhydwausvuaaiw:YOUR_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# Supabase Auth (optional)
SUPABASE_URL=https://tsokfguhydwausvuaaiw.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxx

# JWT Secret (Generate a random 32+ character string)
JWT_SECRET=workergigbd-jwt-secret-2024-secure-key-32chars

# Manus OAuth Server URL (Your Manus platform URL)
OAUTH_SERVER_URL=https://your-manus-url.com

# App ID for Manus platform
VITE_APP_ID=workergigbd

# Owner Open ID (Admin user ID) - Set after first admin registration
OWNER_OPEN_ID=

# Server Port (optional, default: 3000)
PORT=3000

# Use local demo database (false = use PostgreSQL)
USE_LOCAL_DB=false

# Build-in Forge API (optional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
