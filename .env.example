# ===========================================
# WorkerGigBD - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control!

# ===========================================
# SUPABASE DATABASE CONNECTION
# ===========================================
# 1. Go to: https://supabase.com/dashboard
# 2. Select your project
# 3. Settings → Database
# 4. Find "Connection String" → "URI" tab
# 5. Copy the URI and paste below (replace [YOUR-PASSWORD])
# 
# IMPORTANT: Use port 6543 (Supabase Pooler) NOT 5432!
# 
# Example format:
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# JWT Secret (Generate a random 32+ character string)
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# Manus OAuth Server URL (Your Manus platform URL)
OAUTH_SERVER_URL=https://your-manus-url.com

# App ID for Manus platform
VITE_APP_ID=your-app-id

# Owner Open ID (Admin user ID)
OWNER_OPEN_ID=your-owner-open-id

# Server Port (optional, default: 3000)
PORT=3000

# Build-in Forge API (optional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
