# ===========================================
# WorkerGigBD - Environment Variables Template
# ===========================================

# ─── Supabase PostgreSQL Database ───
DATABASE_URL=postgresql://postgres.xxx:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:password@host:5432/postgres

# ─── Supabase Auth ───
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://xxx.supabase.co/auth/v1/.well-known/jwks.json

# ─── Server Settings ───
PORT=3000
NODE_ENV=production

# ─── Database Mode ───
USE_LOCAL_DB=false

# ─── FORGE API (Optional) ───
# FORGE_API_URL=https://your-forge-api.com
# FORGE_API_KEY=your-api-key

# ─── App Settings ───
APP_ID=workergigbd-app
COOKIE_SECRET=generate-a-64-char-random-hex-string

# ─── Owner OpenID (Admin) ───
# Set this AFTER creating your admin account
# OWNER_OPEN_ID=
